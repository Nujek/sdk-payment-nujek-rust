# Required credentials for the live SDK example. Never commit a populated .env file.
NUJEK_BASE_URL=https://staging-payment-api.nujek.co.id
NUJEK_API_KEY=mc_replace_me
NUJEK_API_SECRET=mcs_replace_me

# Optional endpoint coverage.
# Set this to an existing QRIS Static UUID to test its detail endpoint.
NUJEK_LIVE_TEST_QRIS_STATIC_ID=
NUJEK_LIVE_TEST_CHANNEL_ID=NOBU_QRIS
NUJEK_LIVE_TEST_AMOUNT=10000

# Safety gates. `live` is read-only unless writes are explicitly enabled.
# Enables creation of a test user and QRIS bill in staging.
NUJEK_LIVE_TEST_WRITES=false
# Enables a top-up followed by a debit reversal on the test user's wallet.
NUJEK_LIVE_TEST_WALLET=false
